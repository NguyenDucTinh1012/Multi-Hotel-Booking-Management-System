    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>6770fbdb-367c-4e9c-bc63-20d91680407a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
